{
  "name": "trispr-flow",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/hooks || echo skipped",
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:tauri": "node scripts/tauri-before-dev.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "audit:rust": "node scripts/run-rust-audit.mjs",
    "test:smoke": "npm run build && cargo test --manifest-path src-tauri/Cargo.toml --lib && cargo test --manifest-path src-tauri/Cargo.toml --bins",
    "qa:release": "node scripts/release-qa.mjs",
    "build:installers": "cmd /c scripts\\windows\\build-installers.bat"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
